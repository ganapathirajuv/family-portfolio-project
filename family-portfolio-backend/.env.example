# Family Portfolio Backend Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application metadata
APP_NAME="Family Portfolio API"
APP_VERSION="2.0.0"
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# Server configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# PostgreSQL connection
DATABASE__URL=postgresql://portfolio_admin:secure_password_123@localhost:5432/family_portfolio
DATABASE__ECHO=false
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=3600

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# JWT Configuration
SECURITY__SECRET_KEY=your-super-secret-key-change-in-production-make-it-longer-than-32-characters
SECURITY__ALGORITHM=HS256
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# Password requirements
SECURITY__PASSWORD_MIN_LENGTH=8
SECURITY__MAX_LOGIN_ATTEMPTS=5
SECURITY__LOCKOUT_DURATION_MINUTES=30

# =============================================================================
# LOGGING SETTINGS
# =============================================================================

# Logging configuration
LOGGING__LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING__FORMAT=json  # json, text
LOGGING__FILE_ENABLED=false
LOGGING__FILE_PATH=./logs/family-portfolio.log
LOGGING__MAX_FILE_SIZE=10485760  # 10MB
LOGGING__BACKUP_COUNT=5

# =============================================================================
# CORS SETTINGS
# =============================================================================

# CORS configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================

# File upload configuration
FILE_UPLOAD__UPLOAD_PATH=./uploads
FILE_UPLOAD__MAX_FILE_SIZE=10485760  # 10MB in bytes
FILE_UPLOAD__ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx

# =============================================================================
# REDIS SETTINGS
# =============================================================================

# Redis configuration
REDIS__URL=redis://localhost:6379/0
REDIS__MAX_CONNECTIONS=50
REDIS__SOCKET_TIMEOUT=5
REDIS__RETRY_ON_TIMEOUT=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature toggles
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_RATE_LIMITING=false

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# For production deployment, override these values:
#
# ENVIRONMENT=production
# DEBUG=false
# LOGGING__LEVEL=WARNING
# SECURITY__SECRET_KEY=<generate-secure-key>
# DATABASE__URL=<production-database-url>
# CORS_ORIGINS=https://yourdomain.com
# ENABLE_RATE_LIMITING=true